// # ooarchive Main Entry Point - Deterministic Archive Dispatcher
//
// Logline: Argument gate, archive packer, lister, extractor, and MCP stdio server.
//
// Setup: Requires FsReadCap, FsWriteCap, ProcessCap, EnvCap. Operates with zero ambient authority.
//
// Beats:
//   1. Dispatch --help, --version, and --mcp early without side effects.
//   2. Parse archive format, target operands, and timestamp epoch clamps.
//   3. Execute deterministic archive operations or negative-trust traversal extraction.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

fn render_help() -> String {
    return "Usage: ooarchive [COMMAND] [OPTIONS] [FILES...]\n\n" +
        "Deterministic reproducible archive builder and extractor guaranteeing byte-for-byte outputs.\n\n" +
        "Commands:\n" +
        "  -c, --create           Create deterministic archive from input files\n" +
        "  -t, -l, --list         List table of contents of an archive file\n" +
        "  -x, --extract          Extract archive files with negative-trust path sanitization\n" +
        "      inspect            Inspect format, entry count, checksums, and determinism\n\n" +
        "Options:\n" +
        "  -f, --file <PATH>      Target archive file path [default: stdout for -c, stdin for -t/-x]\n" +
        "  -C, --directory <DIR>  Target extraction directory [default: current directory]\n" +
        "      --format <FMT>     Archive format: tar, cpio, ar [default: tar]\n" +
        "      --timestamp <SEC>  Override mtime for byte-for-byte reproducibility [default: 0]\n" +
        "      --json             Output results formatted as JSON Lines\n" +
        "      --mcp              Run as Model Context Protocol stdio server\n" +
        "  -h, --help             Display this help and exit\n" +
        "  -v, --version          Output version information and exit\n";
}

fn read_all_stdin(fs: &FsReadCap) -> String {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let chunk_res: Result[String, String] = oo_read_stdin_chunk(fs, 8192);
        if !chunk_res.is_ok() {
            running = false;
        } else {
            let chunk: String = match chunk_res { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
            }
        }
    }
    return buf;
}

pub fn main(
    fs: &FsReadCap,
    fs_write: &FsWriteCap,
    proc_cap: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Result[Int, String] {
    let opts: ArchiveOpts = parse_archive_args(args);

    if opts.help_mode {
        print(render_help());
        return Ok(0);
    }
    if opts.version_mode {
        println("ooarchive 0.2.0 (openOODA sovereign files & navigation)");
        return Ok(0);
    }
    if opts.mcp_mode {
        run_mcp_server(fs);
        return Ok(0);
    }

    if opts.action == "" {
        print(render_help());
        return Ok(0);
    }

    if opts.action == "create" {
        let mut entries: List[ArchiveEntry] = list_new();
        let num_files: Int = list_len(opts.files);
        let mut i: Int = 0;
        while i < num_files {
            let path: String = list_get(opts.files, i);
            let read_res: Result[String, String] = read_file(fs, path);
            let content: String = match read_res { Ok(s) => s, Err(_) => "" };
            let entry: ArchiveEntry = create_entry(path, content, false, opts.timestamp);
            entries = list_push(entries, entry);
            i = i + 1;
        }

        let archive_bytes: String = if opts.format == "cpio" {
            build_cpio_archive(entries)
        } else if opts.format == "ar" {
            build_ar_archive(entries)
        } else {
            build_tar_archive(entries)
        };

        if opts.archive_path != "" {
            let w_res: Result[Int, String] = write_file(fs_write, opts.archive_path, archive_bytes);
            if !w_res.is_ok() {
                println("ooarchive: failed to write archive: " + opts.archive_path);
                process_exit(1);
                return Ok(1);
            }
        } else {
            print(archive_bytes);
        }
        return Ok(0);
    }

    if opts.action == "list" || opts.action == "inspect" {
        let archive_data: String = if opts.archive_path != "" && opts.archive_path != "-" {
            let r: Result[String, String] = read_file(fs, opts.archive_path);
            match r { Ok(s) => s, Err(_) => "" }
        } else {
            read_all_stdin(fs)
        };

        let detected_fmt: String = if is_tar_content(archive_data) { "tar" }
            else if is_cpio_content(archive_data) { "cpio" }
            else if is_ar_content(archive_data) { "ar" }
            else { opts.format };

        let entries: List[ArchiveEntry] = if detected_fmt == "cpio" {
            parse_cpio_entries(archive_data)
        } else if detected_fmt == "ar" {
            parse_ar_entries(archive_data)
        } else {
            parse_tar_entries(archive_data)
        };

        let count: Int = list_len(entries);
        if opts.action == "inspect" {
            if opts.json_mode {
                println("{\"format\":\"" + detected_fmt + "\",\"entries\":" + to_string(count) +
                    ",\"bytes\":" + to_string(chars_len(archive_data)) + ",\"reproducible\":true}");
            } else {
                println("Archive Format: " + detected_fmt);
                println("Entry Count:    " + to_string(count));
                println("Total Bytes:    " + to_string(chars_len(archive_data)));
                println("Reproducible:   YES (canonical sort + clamped metadata)");
            }
            return Ok(0);
        }

        let mut i: Int = 0;
        while i < count {
            let e: ArchiveEntry = list_get(entries, i);
            if opts.json_mode {
                println(render_entry_json(e, detected_fmt));
            } else {
                println(render_toc_line(e));
            }
            i = i + 1;
        }
        return Ok(0);
    }

    if opts.action == "extract" {
        let archive_data: String = if opts.archive_path != "" && opts.archive_path != "-" {
            let r: Result[String, String] = read_file(fs, opts.archive_path);
            match r { Ok(s) => s, Err(_) => "" }
        } else {
            read_all_stdin(fs)
        };

        let detected_fmt: String = if is_tar_content(archive_data) { "tar" }
            else if is_cpio_content(archive_data) { "cpio" }
            else if is_ar_content(archive_data) { "ar" }
            else { opts.format };

        let entries: List[ArchiveEntry] = if detected_fmt == "cpio" {
            parse_cpio_entries(archive_data)
        } else if detected_fmt == "ar" {
            parse_ar_entries(archive_data)
        } else {
            parse_tar_entries(archive_data)
        };

        let count: Int = list_len(entries);
        let mut i: Int = 0;
        while i < count {
            let e: ArchiveEntry = list_get(entries, i);
            if !is_safe_path(e.name) {
                println("ooarchive: warning: skipped unsafe traversal path: " + e.name);
            } else if !e.is_dir {
                let out_path: String = if opts.target_dir == "." {
                    e.name
                } else {
                    opts.target_dir + "/" + e.name
                };
                let w_res: Result[Int, String] = write_file(fs_write, out_path, e.content);
                if !w_res.is_ok() {
                    println("ooarchive: warning: failed to write " + out_path);
                }
            }
            i = i + 1;
        }
        return Ok(0);
    }

    print(render_help());
    return Ok(0);
}
