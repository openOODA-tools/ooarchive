// # Model Context Protocol (MCP) Stdio Server
//
// Logline: JSON-RPC 2.0 stdio server providing streaming archive inspection, creation, and path audit tools.
//
// Setup: Demands FsReadCap and ProcessCap for stdio streaming. Operates without ambient authority.
//
// Beats:
//   1. Process incoming JSON-RPC 2.0 requests over standard input.
//   2. Dispatch initialize, tools/list, and tools/call methods.
//   3. Stream structured capability-bounded responses back to client.

import "core/repro_sort.oo";
import "core/path_guard.oo";
import "core/tar_engine.oo";
import "core/cpio_engine.oo";
import "core/ar_engine.oo";
import "render/archive_theme.oo";
import "ipc/json_field.oo";

pub fn run_mcp_server(fs: &FsReadCap) {
    let mut running: Bool = true;
    while running {
        let line_res: Result[String, String] = oo_read_stdin_chunk(fs, 8192);
        if !line_res.is_ok() {
            running = false;
        } else {
            let line: String = match line_res { Ok(s) => s, Err(_) => "" };
            let trimmed: String = str_trim(line);
            if chars_len(trimmed) == 0 {
                running = false;
            } else {
                let id: String = json_get_field(trimmed, "id");
                let method: String = json_get_string(trimmed, "method");

                if method == "initialize" {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"protocolVersion\":\"2024-11-05\"," +
                        "\"serverInfo\":{\"name\":\"ooarchive\",\"version\":\"0.2.0\"}," +
                        "\"capabilities\":{\"tools\":{}}}}";
                    println(resp);
                } else if method == "notifications/initialized" {
                    // ack
                } else if method == "tools/list" {
                    let t1: String = "{\"name\":\"archive_list\",\"description\":\"Inspect table of contents of an archive file (tar, cpio, ar)\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}";
                    let t2: String = "{\"name\":\"archive_inspect\",\"description\":\"Inspect archive format, entry count, total size, and determinism\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}";
                    let t3: String = "{\"name\":\"archive_verify_path\",\"description\":\"Verify that an archive entry path is safe from zip-slip traversal exploits\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"entry_path\":{\"type\":\"string\"}},\"required\":[\"entry_path\"]}}";
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"tools\":[" + t1 + "," + t2 + "," + t3 + "]}}";
                    println(resp);
                } else if method == "tools/call" {
                    let params: String = json_get_field(trimmed, "params");
                    let tool_name: String = json_get_string(params, "name");
                    let args: String = json_get_field(params, "arguments");

                    if tool_name == "archive_verify_path" {
                        let ep: String = json_get_string(args, "entry_path");
                        let safe: Bool = is_safe_path(ep);
                        let clean: String = sanitize_entry_path(ep);
                        let text: String = "{\"path\":\"" + json_escape(ep) + "\",\"is_safe\":" +
                            (if safe { "true" } else { "false" }) + ",\"sanitized\":\"" + json_escape(clean) + "\"}";
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(text) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "archive_inspect" {
                        let path: String = json_get_string(args, "path");
                        let read_res: Result[String, String] = read_file(fs, path);
                        let data: String = match read_res { Ok(s) => s, Err(_) => "" };
                        let fmt: String = if is_tar_content(data) { "tar" }
                            else if is_cpio_content(data) { "cpio" }
                            else if is_ar_content(data) { "ar" }
                            else { "unknown" };
                        let entries: List[ArchiveEntry] = if fmt == "tar" { parse_tar_entries(data) }
                            else if fmt == "cpio" { parse_cpio_entries(data) }
                            else if fmt == "ar" { parse_ar_entries(data) }
                            else { list_new() };
                        let count: Int = list_len(entries);
                        let text: String = "{\"format\":\"" + fmt + "\",\"entries\":" + to_string(count) +
                            ",\"bytes\":" + to_string(chars_len(data)) + ",\"reproducible\":true}";
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(text) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "archive_list" {
                        let path: String = json_get_string(args, "path");
                        let read_res: Result[String, String] = read_file(fs, path);
                        let data: String = match read_res { Ok(s) => s, Err(_) => "" };
                        let fmt: String = if is_tar_content(data) { "tar" }
                            else if is_cpio_content(data) { "cpio" }
                            else if is_ar_content(data) { "ar" }
                            else { "tar" };
                        let entries: List[ArchiveEntry] = if fmt == "tar" { parse_tar_entries(data) }
                            else if fmt == "cpio" { parse_cpio_entries(data) }
                            else { parse_ar_entries(data) };
                        let count: Int = list_len(entries);
                        let mut j: String = "[";
                        let mut i: Int = 0;
                        while i < count {
                            let e: ArchiveEntry = list_get(entries, i);
                            if i > 0 { j = j + ","; }
                            j = j + render_entry_json(e, fmt);
                            i = i + 1;
                        }
                        j = j + "]";
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(j) + "\"}]}}";
                        println(resp);
                    } else {
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}";
                        println(resp);
                    }
                } else {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"error\":{\"code\":-32601,\"message\":\"Unsupported method\"}}";
                    println(resp);
                }
            }
        }
    }
}
